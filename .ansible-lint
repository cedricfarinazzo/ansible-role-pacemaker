---
profile: production
skip_list:
  - yaml[line-length]  # long shell checks
loop_var_prefix: "^(__|{role}_)"
exclude_paths:
  - .cache/
  - .github/
  - .venv/
  - node_modules/
  - molecule/shared/roles/
# Task files the scenarios include, not playbooks
kinds:
  - tasks: "molecule/shared/{recap,online,cib}.yml"
  - tasks: "molecule/upgrade/{publish,state}.yml"
